#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define HASH_SIZE 1000003

typedef struct {
    int* keys;
    char* used;
} HashSet;

HashSet* createSet() {
    HashSet* set = (HashSet*)malloc(sizeof(HashSet));
    set->keys = (int*)calloc(HASH_SIZE, sizeof(int));
    set->used = (char*)calloc(HASH_SIZE, sizeof(char));
    return set;
}

int insertSet(HashSet* set, int key) {
    unsigned int hash = (unsigned int)key % HASH_SIZE;
    while (set->used[hash]) {
        if (set->keys[hash] == key) {
            return 0; 
        }
        hash = (hash + 1) % HASH_SIZE;
    }
    set->keys[hash] = key;
    set->used[hash] = 1;
    return 1; 
}

void freeSet(HashSet* set) {
    free(set->keys);
    free(set->used);
    free(set);
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    if (arrSize == 0) return 0;
    HashSet* global_unique = createSet();
    int unique_count = 0;
    int current_ends[33];
    int current_size = 0;

    for (int i = 0; i < arrSize; i++) {
        int num = arr[i];
        for (int j = 0; j < current_size; j++) {
            current_ends[j] |= num;
        }   
        current_ends[current_size++] = num;
        int write_idx = 0;
        for (int read_idx = 1; read_idx < current_size; read_idx++) {
            if (current_ends[write_idx] != current_ends[read_idx]) {
                current_ends[++write_idx] = current_ends[read_idx];
            }
        }
        current_size = write_idx + 1;
        for (int j = 0; j < current_size; j++) {
            if (insertSet(global_unique, current_ends[j])) {
                unique_count++;
            }
        }
    }
    freeSet(global_unique);
    return unique_count;
}
