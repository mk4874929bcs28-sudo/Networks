#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INF 1e9

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    // 1. Allocate and initialize pricing arrays
    int* prices = (int*)malloc(n * sizeof(int));
    int* temp_prices = (int*)malloc(n * sizeof(int));
    
    for (int i = 0; i < n; i++) {
        prices[i] = INF;
    }
    prices[src] = 0; // Starting point cost is always 0

    // 2. Relax edges at most K + 1 times (corresponds to K stops)
    for (int i = 0; i <= k; i++) {
        // Clone the previous iteration's steady-state pricing
        memcpy(temp_prices, prices, n * sizeof(int));

        // Scan through all available flights
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];   // Flight source
            int v = flights[j][1];   // Flight destination
            int price = flights[j][2]; // Ticket cost

            // Only propagate paths from nodes already reached in a previous step
            if (prices[u] != INF) {
                if (prices[u] + price < temp_prices[v]) {
                    temp_prices[v] = prices[u] + price;
                }
            }
        }
        
        // Update the master pricing tracking map for the next level iteration
        memcpy(prices, temp_prices, n * sizeof(int));
    }

    // 3. Extract target result
    int final_price = prices[dst];

    // Clean up allocated heap memory blocks
    free(prices);
    free(temp_prices);

    // Return the cost if reachable, otherwise -1
    return (final_price == INF) ? -1 : final_price;
}
