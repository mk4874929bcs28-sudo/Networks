#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <stdbool.h>

#define INF 1e9

// Structure to represent a node in our Priority Queue (Min-Heap)
typedef struct {
    int effort;
    int r;
    int c;
} HeapNode;

// Structure for the Min-Heap Priority Queue
typedef struct {
    HeapNode* data;
    int size;
    int capacity;
} MinHeap;

// Helper to initialize the min-heap
MinHeap* createMinHeap(int capacity) {
    MinHeap* heap = (MinHeap*)malloc(sizeof(MinHeap));
    heap->data = (HeapNode*)malloc(capacity * sizeof(HeapNode));
    heap->size = 0;
    heap->capacity = capacity;
    return heap;
}

// Swapping utility
void swap(HeapNode* a, HeapNode* b) {
    HeapNode temp = *a;
    *a = *b;
    *b = temp;
}

// Heapify up to maintain min-heap property after insertion
void heapifyUp(MinHeap* heap, int idx) {
    while (idx > 0 && heap->data[idx].effort < heap->data[(idx - 1) / 2].effort) {
        swap(&heap->data[idx], &heap->data[(idx - 1) / 2]);
        idx = (idx - 1) / 2;
    }
}

// Heapify down to maintain min-heap property after extraction
void heapifyDown(MinHeap* heap, int idx) {
    int smallest = idx;
    int left = 2 * idx + 1;
    int right = 2 * idx + 2;

    if (left < heap->size && heap->data[left].effort < heap->data[smallest].effort)
        smallest = left;
    if (right < heap->size && heap->data[right].effort < heap->data[smallest].effort)
        smallest = right;

    if (smallest != idx) {
        swap(&heap->data[idx], &heap->data[smallest]);
        heapifyDown(heap, smallest);
    }
}

// Push an element onto the min-heap
void push(MinHeap* heap, int effort, int r, int c) {
    if (heap->size == heap->capacity) return; // Heap full boundary
    heap->data[heap->size].effort = effort;
    heap->data[heap->size].r = r;
    heap->data[heap->size].c = c;
    heap->size++;
    heapifyUp(heap, heap->size - 1);
}

// Pop the minimum element off the heap
HeapNode pop(MinHeap* heap) {
    HeapNode root = heap->data[0];
    heap->data[0] = heap->data[heap->size - 1];
    heap->size--;
    heapifyDown(heap, 0);
    return root;
}

// Main LeetCode entry function
int minimumEffortPath(int** heights, int heightsSize, int* heightsColSize) {
    int rows = heightsSize;
    int cols = heightsColSize[0];

    // Array to track the minimum effort required to reach each cell
    int** efforts = (int**)malloc(rows * sizeof(int*));
    for (int i = 0; i < rows; i++) {
        efforts[i] = (int*)malloc(cols * sizeof(int));
        for (int j = 0; j < cols; j++) {
            efforts[i][j] = INF;
        }
    }

    // Allocate Priority Queue
    MinHeap* heap = createMinHeap(rows * cols * 4);
    
    // Direction vectors for moving up, down, left, right
    int dr[] = {-1, 1, 0, 0};
    int dc[] = {0, 0, -1, 1};

    // Initialize starting position
    efforts[0][0] = 0;
    push(heap, 0, 0, 0);

    while (heap->size > 0) {
        HeapNode curr = pop(heap);
        int effort = curr.effort;
        int r = curr.r;
        int c = curr.c;

        // Optimization: if we found a path to the target cell, return it
        if (r == rows - 1 && c == cols - 1) {
            // Free allocated memory space
            for (int i = 0; i < rows; i++) free(efforts[i]);
            free(efforts);
            free(heap->data);
            free(heap);
            return effort;
        }

        // Skip processing if a better path to this node has already been found
        if (effort > efforts[r][c]) continue;

        // Traverse the 4 adjacent neighbors
        for (int i = 0; i < 4; i++) {
            int nr = r + dr[i];
            int nc = c + dc[i];

            // Boundaries check
            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
                // Calculate current path leg cost
                int current_step_effort = abs(heights[r][c] - heights[nr][nc]);
                // Max path effort updates continuously along the track
                int next_effort = (effort > current_step_effort) ? effort : current_step_effort;

                // Relaxation condition
                if (next_effort < efforts[nr][nc]) {
                    efforts[nr][nc] = next_effort;
                    push(heap, next_effort, nr, nc);
                }
            }
        }
    }

    return 0; // Fallback
}
