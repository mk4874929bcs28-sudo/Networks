/*
 * Complete the 'riddle' function below.
 *
 * The function is expected to return a LONG_INTEGER_ARRAY.
 * The function accepts LONG_INTEGER_ARRAY arr as parameter.
 */

long* riddle(int arr_count, long* arr, int* result_count) {

    int n = arr_count;

    // Result array
    long* result = malloc(n * sizeof(long));

    // Arrays to store previous and next smaller element indices
    int* left = malloc(n * sizeof(int));
    int* right = malloc(n * sizeof(int));

    // Stack for indices
    int* stack = malloc(n * sizeof(int));

    int top = -1;

    // Find Previous Smaller Element
    for (int i = 0; i < n; i++) {

        while (top != -1 && arr[stack[top]] >= arr[i]) {
            top--;
        }

        if (top == -1)
            left[i] = -1;
        else
            left[i] = stack[top];

        stack[++top] = i;
    }

    top = -1;

    // Find Next Smaller Element
    for (int i = n - 1; i >= 0; i--) {

        while (top != -1 && arr[stack[top]] >= arr[i]) {
            top--;
        }

        if (top == -1)
            right[i] = n;
        else
            right[i] = stack[top];

        stack[++top] = i;
    }

    // Initialize result array
    for (int i = 0; i < n; i++) {
        result[i] = LONG_MIN;
    }

    // Calculate maximum window size for every element
    for (int i = 0; i < n; i++) {

        int windowSize = right[i] - left[i] - 1;

        if (arr[i] > result[windowSize - 1]) {
            result[windowSize - 1] = arr[i];
        }
    }

    // Fill missing values
    for (int i = n - 2; i >= 0; i--) {

        if (result[i] < result[i + 1]) {
            result[i] = result[i + 1];
        }
    }

    *result_count = n;

    free(left);
    free(right);
    free(stack);

    return result;
}

int main()
{
    FILE* fptr = fopen(getenv("OUTPUT_PATH"), "w");

    char* n_endptr;
    char* n_str = readline();

    int n = strtol(n_str, &n_endptr, 10);

    if (n_endptr == n_str || *n_endptr != '\0') {
